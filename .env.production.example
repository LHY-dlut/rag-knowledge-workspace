# Copy to .env, generate secrets, then: docker compose up --build -d
APP_MODE=production
# Start with demo to exercise both real databases without model charges.
# Change to dashscope and fill ALL three entries to use real models.
MODEL_PROVIDER=demo
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=
DASHSCOPE_API_KEY=
DASHSCOPE_HTTP_BASE_URL=
DASHSCOPE_CHAT_BASE_URL=
ENABLE_OCR=false
# Temporarily set true on loopback to create your first account, then false.
ENABLE_REGISTRATION=false
RAG_HTTP_PORT=8080
# Per process. 1 API + 2 workers => at most 3 simultaneous provider requests.
MODEL_CONCURRENCY=1
# Shared across this deployment in MySQL, UTC day; attempts including retries count.
MODEL_DAILY_DISPATCH_LIMIT=300
MODEL_MAX_OUTPUT_TOKENS=2048
# These local URLs are for the optional compose.dev.yml exposed ports.
# URL-encode special characters in database passwords.
BUSINESS_DB_URL=mysql://rag:SET_PASSWORD@127.0.0.1:3307/rag_business
VECTOR_DB_URL=postgres://rag:SET_PASSWORD@127.0.0.1:5433/rag_vectors

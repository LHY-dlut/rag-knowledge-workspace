APP_MODE=demo
MODEL_PROVIDER=demo
BUSINESS_DB_URL=sqlite://data/business.sqlite3
VECTOR_DB_URL=sqlite://data/vectors.sqlite3
JWT_SECRET=local-demo-only-change-me-32-characters
ENABLE_OCR=false
ENABLE_REGISTRATION=true
# Set false to run BOTH ingestion and chat only in: python -m app.worker
# ENABLE_API_WORKERS=false
# Switching only the provider also works with SQLite for a smaller real-model trial.
# MODEL_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# Set the regional URLs shown in your own Model Studio console.
# DASHSCOPE_HTTP_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
# DASHSCOPE_CHAT_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
